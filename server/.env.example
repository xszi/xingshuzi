# 后端环境变量模板
# 部署时复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交进库，请勿把真实密码写进本文件。

# 远程独立 MySQL（线上）
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_HOST=120.76.247.123
MYSQL_PORT=3306
MYSQL_DB=xingshuzi

# 生产密钥（用下方命令各生成一个随机值后替换）
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_random_hex
JWT_SECRET_KEY=change_me_random_hex

# 对外可访问的后端根地址（配图 URL 生成与修正）
PUBLIC_BASE_URL=http://120.76.247.123:5001
